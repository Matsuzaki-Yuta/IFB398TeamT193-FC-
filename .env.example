# Copy this file to ".env" in the project root and fill in the real values.
#
#   Windows:  copy .env.example .env
#   macOS:    cp .env.example .env
#
# .env is listed in .gitignore and must never be committed. This file is the
# committed copy: placeholders only, so a teammate cloning the repo can see
# exactly which settings exist without any of us sharing a password.

# ── Gemini (existing) ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Email: sending the final quote ────────────────────────────────────────────
# These settings are for Gmail. Two things to know before it will work:
#
#   1. 2-Step Verification must be ON for the Google account.
#   2. SMTP_PASSWORD is a 16-character App Password, NOT the account password.
#      Create one at https://myaccount.google.com/apppasswords
#      Paste it without the spaces Google shows it in.
#
# The team account below is a plain personal @gmail.com created for this
# project, which is the right call: a QUT or other Google Workspace account can
# have App Passwords switched off by an administrator, and the whole team
# sharing one project account keeps the send address consistent in the demo.
#
# Do NOT commit the App Password. Each of us puts it in our own .env.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ifb398qut.phygital@gmail.com
SMTP_PASSWORD=your16charapppassword

# Gmail rewrites the From header to whichever account signed in, so this should
# be the same address as SMTP_USERNAME. The display name is yours to choose and
# is what the customer sees in their inbox.
MAIL_FROM_EMAIL=ifb398qut.phygital@gmail.com
MAIL_FROM_NAME=Flight Centre Trip Bridge

# Optional. Where a customer's reply goes, if that should differ from the
# sending account. Leave blank to have replies go back to MAIL_FROM_EMAIL.
MAIL_REPLY_TO=

# Optional. Seconds to wait on the mail server before giving up.
SMTP_TIMEOUT=20

# One more Gmail setting worth knowing: SMTP_SECURITY defaults to starttls on
# port 587, which is what Gmail wants. Set it to ssl if you switch to port 465.
# SMTP_SECURITY=starttls

# ── Local testing without sending real email ──────────────────────────────────
# Option A: Python's built-in debug server. Run this in a second terminal:
#     python -m smtpd -c DebuggingServer -n localhost:1025      (Python <= 3.11)
#     python -m aiosmtpd -n -l localhost:1025                   (Python 3.12+)
# then swap the four settings above for:
#     SMTP_HOST=localhost
#     SMTP_PORT=1025
#     SMTP_USERNAME=test@example.com
#     SMTP_PASSWORD=unused
# The message prints to that terminal and no email leaves the machine.
#
# Option B: a Mailtrap sandbox inbox (free), which catches every message and
# shows it rendered, with the PDF attached. Paste the credentials it gives you
# into SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD.
